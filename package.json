{
  "name": "aws-azure-login",
  "version": "4.0.0",
  "description": "Use Azure AD SSO to log into the AWS CLI.",
  "main": "index.js",
  "author": {
    "name": "aws-azure-login devs",
    "url": "https://github.com/aws-azure-login"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aws-azure-login/aws-azure-login.git"
  },
  "bugs": "https://github.com/aws-azure-loginc/aws-azure-login/issues",
  "engines": {
    "node": ">=20.0"
  },
  "bin": {
    "aws-azure-login": "dist/aws-azure-login"
  },
  "scripts": {
    "start": "ts-node src/index.ts",
    "build": "tsc && node esbuild.config.mjs",
    "watch": "tsc -w",
    "eslint": "eslint src/",
    "prettier:write": "prettier --write \"src/**/*.{ts,json}\"",
    "prettier:check": "prettier --check \"src/**/*.ts\"",
    "test": "yarn eslint && yarn prettier:check"
  },
  "dependencies": {
    "@aws-sdk/client-sts": "^3.473.0",
    "@aws-sdk/credential-provider-node": "^3.972.10",
    "@smithy/node-http-handler": "^2.5.0",
    "cheerio": "^1.2.0",
    "commander": "^9.5.0",
    "debug": "^4.3.1",
    "ini": "^3.0.1",
    "inquirer": "^8.2.6",
    "lodash": "^4.17.21",
    "mkdirp": "^1.0.4",
    "proxy-agent": "^6.4.0",
    "puppeteer": "^24.0.0",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@types/cheerio": "^1.0.0",
    "@types/debug": "^4.1.12",
    "@types/ini": "^1.3.34",
    "@types/inquirer": "^8.2.10",
    "@types/lodash": "^4.17.0",
    "@types/mkdirp": "^1.0.2",
    "@types/node": "^20.11.30",
    "@types/uuid": "^8.3.4",
    "@eslint/js": "^10.0.0",
    "esbuild": "^0.27.3",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "typescript-eslint": "^8.56.0",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3"
  }
}
